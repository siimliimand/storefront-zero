parameters:
    level: 8
    paths:
        - app/
        - functions.php
    excludePaths:
        - vendor/
        - node_modules/
        - assets/
        - woocommerce/
        - tests/
    stubFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - vendor/php-stubs/woocommerce-stubs/stubs.php

includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon
